# Sweeps old build output out of the dev clone's target/, which tools/disk.ts holds to a 9 GiB
# budget. It runs from deploy/svanbot-clean.timer; deploy/README.md is the runbook.
[Unit]
Description=SvanBot cleanup: build output untouched for 14 days (cargo sweep)

[Service]
Type=oneshot
# The dev clone, where every v11 build happens. The fleet's checkout is never built in.
WorkingDirectory=%h/NewSvanBot
# MISE_ENV=box loads mise.box.toml, which pins cargo-sweep.
Environment=MISE_ENV=box CARGO_TARGET_DIR=target/dev
ExecStart=%h/.local/bin/mise exec -- cargo sweep --time 14
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=3600
