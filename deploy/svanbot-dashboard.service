# The dashboard: `systemctl --user enable --now svanbot-dashboard`. It listens on loopback only,
# reach it through an SSH tunnel (deploy/README.md), and it needs no venue key. The page is
# compiled into the binary; the status files are written by the bots.
[Unit]
Description=SvanBot fleet dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
Environment=SVANBOT_DATA=%h/.local/share/svanbot
Environment=SVANBOT_LIB=%h/.local/lib/svanbot
Environment=SVANBOT_DASHBOARD_ADDR=127.0.0.1:5000
ExecStart=%h/.local/lib/svanbot/current/svanbot dashboard
Restart=on-failure
RestartSec=5
# 2: the setup or the listen address is wrong. A restart cannot fix either.
RestartPreventExitStatus=2
# It reads small files and serves one page. A cap keeps a leak from reaching the box's bots.
MemoryMax=256M
NoNewPrivileges=yes

[Install]
WantedBy=default.target
