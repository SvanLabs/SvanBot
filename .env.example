# SvanBot configuration. Copy to .env and fill in your openpoker.ai Self Host API keys.
# Keys are shown once when you create a bot (openpoker.ai dashboard -> bot -> Self Host).

# Main bot
SVANBOT_API_KEY=
SVANBOT_MAIN_NAME=
# Extra portfolio bots (Pro accounts can run up to five); leave unused ones empty.
OPENPOKER_API_KEY_2=
BOT_2_NAME=
OPENPOKER_API_KEY_3=
BOT_3_NAME=
OPENPOKER_API_KEY_4=
BOT_4_NAME=
OPENPOKER_API_KEY_5=
BOT_5_NAME=

SVANBOT_SERVER_URL=wss://openpoker.ai/ws
# Maximum buy-in per table (1000-5000 chips).
SVANBOT_BUY_IN=5000
# Seek tables with a current-season top-N bot (0 disables).
SVANBOT_SEEK_TOP_RANK=30
# Bank winnings: leave and rejoin with a fresh buy-in once the table stack reaches this many big blinds (0 disables).
SVANBOT_BANK_STACK_BB=2000

# Dashboard. Use 127.0.0.1 to keep it local; 0.0.0.0 exposes it on your network.
SVANBOT_WEB__HOST=127.0.0.1
SVANBOT_WEB_PORT=5000
# Password for the dashboard (pick any long random string).
SVANBOT_WEB__OPERATOR_TOKEN=

# true = start without connecting to openpoker.ai.
SVANBOT_RUNTIME__DRY_RUN=false
SVANBOT_RUNTIME__FLEET_SIZE=5

# Archive root for `archive run` (daily/weekly/monthly, see docs/OPERATIONS.md). Point it at a second
# disk; defaults to artifacts/archive.
# SVANBOT_ARCHIVE_DIR=/mnt/backup/svanbot10

# --- Every operator setting, explicit (2026-09-23). Values equal the code defaults unless noted. ---
# REST base for season, leaderboard and history calls.
SVANBOT_REST_BASE=https://api.openpoker.ai/api
# Deepest hand exported per bot for history import (0 = unlimited; Free tier stops at 20,000).
SVANBOT_EXPORT_CAP=20000
# Process layout: "all" = one fleet process; "split" = head + one worker process per bot (0128).
# Takes effect at the next scripts/stop.sh + scripts/start.sh.
SVANBOT_FLEET=all
# Learner pacing (read by the learner since 2026-09-23). New live hands before the next search
# cycle: 100 (was 500): a cycle takes ~7 min and waited ~70 min for 500 hands; now ~13 min.
LEARNER_MIN_NEW_HANDS=100
# Minutes after a cycle before a follow-up (the dashboard setting overrides this).
LEARNER_COOLDOWN_MINUTES=60
LEARNER_MAX_BACKOFF=1
LEARNER_MAX_IDLE_HOURS=6
# Threads and deep-search budget: unset = every logical core and 10x the live budget.
# LEARNER_THREADS=8
# ANALYST_THREADS=8
# ANALYST_SAMPLES=16000000
# Earlier names of a renamed bot (new:old, comma-separated) so its season stays one record.
# SVANBOT_ALIASES=NewName:OldName
