# Template, not an installable unit: scripts/units.sh fills @SVANBOT_ROOT@ in with the checkout it
# is run from and writes the result into ~/.config/systemd/user/ (scripts/archive-timer.sh renders
# it and enables the timer). Copying this file by hand installs a unit that points at nothing.
[Unit]
Description=SvanBot archive: daily differential, weekly full, monthly archive into SVANBOT_ARCHIVE_DIR

[Service]
Type=oneshot
WorkingDirectory=@SVANBOT_ROOT@
EnvironmentFile=-@SVANBOT_ROOT@/.env
ExecStart="@SVANBOT_ROOT@/target/release/archive" run
Nice=15
IOSchedulingClass=idle
# A run is ~4 min (monthly recompression is the slow part); anything past 1 h is hung.
TimeoutStartSec=3600
# Never compete with live play for memory.
OOMScoreAdjust=500
