/target/
/artifacts/*
!/artifacts/README.md
/web/dist/
# No trailing slash: the pattern must also cover the `web/node_modules` symlink that worktrees use
# to reach the main checkout's install, which a directory-only pattern leaves untracked and addable.
/web/node_modules
/web/test-results/
/web/playwright-report/
.env
/web/tsconfig.tsbuildinfo

# Claude Code local state
/.claude/scheduled_tasks.lock
/.claude/settings.local.json
.claude/worktrees/
# Another agent harness's local state (its own worktrees and settings), same class as .claude/.
/.openclaude/
/vendor/
__pycache__/
