{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/provenance-after-commit.py\""
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(CARGO_TARGET_DIR=target/dev cargo build:*)",
      "Bash(cargo fmt:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo tree:*)",
      "Bash(python3 scripts/test.py:*)",
      "Bash(python3 scripts/provenance.py:*)",
      "Bash(python3 scripts/docs-check.py:*)",
      "Bash(scripts/check.sh commit:*)",
      "Bash(bash scripts/check.sh commit:*)",
      "Bash(scripts/check-file-size.sh:*)",
      "Bash(bash scripts/check-file-size.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git rev-parse:*)",
      "Bash(git ls-files:*)",
      "Bash(git grep:*)",
      "Bash(git describe:*)",
      "Bash(git shortlog:*)"
    ]
  }
}
